{
  "name": "gun-wizards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm test && npm run build",
    "server:build": "spacetime build --module-path server/spacetimedb",
    "server:start": "spacetime start --listen-addr 127.0.0.1:3000 --data-dir .local/spacetime",
    "server:publish": "spacetime publish --server http://127.0.0.1:3000 --module-path server/spacetimedb gun-wizards-local -y",
    "bindings": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path server/spacetimedb && node tools/normalize-bindings.mjs",
    "setup": "node tools/setup.mjs",
    "test:multiplayer": "node --import tsx tools/playtest.ts",
    "test:jev": "node --import tsx tools/playtest.ts --jev",
    "research:fracture": "node --import tsx tools/research/fracture-benchmark.ts",
    "format": "prettier --write src shared tests tools/*.ts server/spacetimedb/src",
    "format:check": "prettier --check src shared tests tools/*.ts server/spacetimedb/src",
    "test:destruction": "node --import tsx tools/test-destruction.ts",
    "assets:fragments": "node --import tsx tools/build-fragments.ts"
  },
  "dependencies": {
    "spacetimedb": "2.10.2",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@dgreenheck/three-pinata": "^2.0.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0"
  }
}
